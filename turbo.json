{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*", ".env", "**/.env"],
  "tasks": {
    // The Prisma client is generated code, gitignored, and therefore absent on
    // a clean clone — which is exactly what CI and Vercel get. Modelling it as
    // a task (rather than shelling `prisma generate &&` into each script) means
    // it runs once, is cached on the schema alone, and can be depended on by
    // build, typecheck and the test tasks alike. Packages without a
    // `db:generate` script simply skip it.
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"]
    },
    // Expo Router's typed routes (`experiments.typedRoutes` in app.json) work
    // the same way: `.expo/types/router.d.ts` and `expo-env.d.ts` are
    // generated code, gitignored, and therefore absent on a clean clone. They
    // are normally written by the dev server on first bundle, but `tsc` never
    // starts the dev server — so without this task a clean checkout's
    // `typecheck` doesn't fail on a stale/renamed href, it just silently
    // stops checking hrefs at all (the augmented `Href` type is simply
    // missing, so `expo-router` falls back to its unaugmented, unchecked
    // type). `expo customize tsconfig.json` is the documented way to run
    // Expo CLI's type generation without a running Metro/dev-server instance;
    // tsconfig.json's `include` and the `expo-env.d.ts` gitignore entry are
    // already committed, so repeat runs only rewrite the two generated files
    // declared as outputs below.
    "routes:generate": {
      "inputs": ["app.json", "app/**/*.ts", "app/**/*.tsx"],
      "outputs": [".expo/types/**", "expo-env.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", "build/**"],
      // Declared so Vercel does not strip them from the build environment and
      // so a changed value correctly busts the cache. The list is every key
      // apps/backend/src/lib/config.ts reads; keep the two in step. The build itself reads
      // none of them today — `prisma generate` needs no DATABASE_URL because
      // the datasource carries no `url` (Prisma 7 driver adapters supply it at
      // runtime) — but the app reads them when it boots.
      "env": [
        "APP_STORE_URL",
        "AUTH_SECRET",
        "CRON_SECRET",
        "DATABASE_URL",
        "DEV_USER_SWITCHER",
        "ENABLE_API_DOCS",
        "ENABLE_PUSH",
        "ENABLE_UPLOADS",
        "EXPO_ACCESS_TOKEN",
        "GMAIL_APP_PASSWORD",
        "GMAIL_USER",
        "GOOGLE_CLIENT_IDS",
        "IMPORT_BODY_LIMIT",
        "IMPORT_COMMIT_RATE_LIMIT",
        "IMPORT_PREVIEW_RATE_LIMIT",
        "INVITE_TOKEN_TTL_HOURS",
        "LOCAL_UPLOADS_DIR",
        "MAX_UPLOAD_BYTES",
        "MOBILE_APP_ORIGIN",
        "MOBILE_APP_SCHEME",
        "NODE_ENV",
        "ORG_TIMEZONE",
        "PLAY_STORE_URL",
        "PORT",
        "RATE_LIMIT_STORE",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_RELEASE",
        "SENTRY_TRACES_SAMPLE_RATE",
        "STORAGE_DRIVER",
        "TRUST_PROXY",
        "VERCEL_GIT_COMMIT_SHA"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate", "routes:generate"],
      "outputs": []
    },
    // No `coverage/**` output: no package runs jest with --coverage, so
    // declaring it made turbo warn "no output files found" on every run.
    "test:unit": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    // Never cached: these tests hit the shared staging database, which Turborepo
    // cannot see. A cache hit would report success for a database that may be
    // unreachable or changed since the run that populated the cache.
    "test:integration": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
