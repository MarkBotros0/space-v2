{
  "name": "space-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm format:check && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json}\"",
    "clean": "turbo run clean",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json}\"",
    "check:dead": "node scripts/check-dead.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm check:dead && pnpm check:size"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
