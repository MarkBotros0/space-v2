# Exports scripts/check-dead.mjs must not report: <file>:<name>  # why it stays exported
# The return type of an exported function in another file (declaration emit needs the name, TS4058).
apps/backend/src/lib/dashboard-figures.ts:StudentAssignmentSummaryFigures
apps/backend/src/lib/dashboard-figures.ts:QuizRollupFigures
# A schema whose only use is the exported type derived from it (`typeof`); unexported, lint calls it unused.
packages/shared/src/import/headers.ts:IMPORT_PROFILE_FIELDS
packages/shared/src/reports/exports.ts:exportKindSchema
packages/shared/src/standing.ts:standingSchema
# Multi-part assignment contracts, consumed by the backend and mobile tasks that follow; remove each line once it is imported.
packages/shared/src/assignment.ts:Reminder
packages/shared/src/assignment.ts:assignmentProgressSchema
packages/shared/src/assignment.ts:AssignmentProgress
packages/shared/src/assignment.ts:DEFAULT_DUE_TIME
packages/shared/src/enums.ts:AssignmentPartKind
packages/shared/src/enums.ts:ReminderAnchor
packages/shared/src/assignment-parts.ts:AssignmentPartInput
packages/shared/src/assignment-progress.ts:partDone
# The first two locks of the per-student write order; Task 8's Submit takes them.
apps/backend/src/lib/assignments/essay.ts:lockAssignmentForWork
apps/backend/src/lib/assignments/essay.ts:lockSubmissionForWork
