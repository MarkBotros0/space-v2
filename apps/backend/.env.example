# Same staging database as jpc-space. Copy the value from D:\Projects\JPC\jpc-space\.env
DATABASE_URL=
# Must be byte-identical to jpc-space's AUTH_SECRET or tokens will not interoperate
AUTH_SECRET=
PORT=4000
NODE_ENV=development
# Number of proxy hops (e.g. a load balancer) in front of this app. Passed to
# Express's `trust proxy`, which controls how req.ip is derived and therefore
# how the auth rate limiters bucket clients. Leave at 0 when not behind a
# proxy; set to the exact number of hops when there is one — trusting more
# hops than actually exist lets a client spoof its own rate-limit bucket via
# X-Forwarded-For.
TRUST_PROXY=0
# Origin allowed to call the API via CORS. Defaults to "*" if unset; set to
# the mobile app's actual origin in any environment where that matters.
MOBILE_APP_ORIGIN=*
# Email is optional — all three of the following are unset by default. When
# GMAIL_USER/GMAIL_APP_PASSWORD are unset, notification emails are disabled
# (in-app notifications are unaffected).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Store pages for "Don't have the app yet?" in emails; unset until the app is published.
APP_STORE_URL=
PLAY_STORE_URL=
# Storage backend for submission files. "local" is the only driver today.
STORAGE_DRIVER=local
# Directory the local driver writes to when STORAGE_DRIVER=local.
LOCAL_UPLOADS_DIR=./uploads
# Hard ceiling on a single upload, in bytes. Backstop only — the real limit is
# each assignment's own maxFileSizeMb. 25 MB.
MAX_UPLOAD_BYTES=26214400

# Accept file uploads. "true" or "false"; defaults to FALSE.
# Off while file/image handling moves to a CMS — POST .../files returns
# 503 uploads_disabled, refused before the body is read. Reading and deleting
# already-recorded files are unaffected.
ENABLE_UPLOADS=false

# Serve Swagger UI at /api/docs and the OpenAPI document at /api/docs.json.
# "true" or "false"; defaults to true.
ENABLE_API_DOCS=true

# IANA timezone for every wall-clock derivation (reschedule notice text,
# weekly recurrence, day bucketing). Defaults to Africa/Cairo.
ORG_TIMEZONE=Africa/Cairo

# How long an invite code stays acceptable, in hours. Defaults to 168 (7 days).
INVITE_TOKEN_TTL_HOURS=168

# URL scheme of the mobile app (apps/mobile/app.json "scheme"). Password-reset
# emails link to <scheme>://reset-password?token=… . Defaults to spacev2.
MOBILE_APP_SCHEME=spacev2

# Import routes only (paste-first student / group importers). Body limit is any
# body-parser size string; rate limits are requests per 15 minutes per IP.
# IMPORT_BODY_LIMIT=2mb
# IMPORT_PREVIEW_RATE_LIMIT=30
# IMPORT_COMMIT_RATE_LIMIT=10

# Where every rate limiter keeps its counters: "postgres" or "memory".
# Unset means postgres (memory when NODE_ENV=test). postgres shares counters
# across serverless instances through the RateLimitHit table; memory is
# per process, so on Vercel each instance would count separately.
# RATE_LIMIT_STORE=postgres

# Push through Expo's push service. On by default; it only reaches devices that
# registered a token. "false" stops all push (in-app rows and email unaffected).
# ENABLE_PUSH=true
# Only if "enhanced push security" is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=

# Sentry error reporting. Entirely off while SENTRY_DSN is unset: nothing is
# initialised and nothing is sent. With it set, every 500 and every failed
# background job (push, mail) is reported; 4xx never is. Request bodies of the
# auth/password/invite routes, the Authorization and Cookie headers and any
# password/token field are stripped before an event leaves.
# SENTRY_DSN=
# Environment tag on each event. Defaults to NODE_ENV.
# SENTRY_ENVIRONMENT=production
# Share of requests traced for performance, 0 to 1. Defaults to 0 (errors only).
# SENTRY_TRACES_SAMPLE_RATE=0
# Release tag. Defaults to VERCEL_GIT_COMMIT_SHA on Vercel, else unset.
# SENTRY_RELEASE=

# Request-driven scheduler: any request may start a sweep of due work (guarded by a
# database lease, at most once a minute per instance). "off" disables it. Default on.
# SCHEDULER_TICK=on
