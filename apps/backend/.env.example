# Same staging database as jpc-space. Copy the value from D:\Projects\JPC\jpc-space\.env
DATABASE_URL=
# Must be byte-identical to jpc-space's AUTH_SECRET or tokens will not interoperate
AUTH_SECRET=
PORT=4000
NODE_ENV=development
# Number of proxy hops (e.g. a load balancer) in front of this app. Passed to
# Express's `trust proxy`, which controls how req.ip is derived and therefore
# how the auth rate limiters bucket clients. Leave at 0 when not behind a
# proxy; set to the exact number of hops when there is one — trusting more
# hops than actually exist lets a client spoof its own rate-limit bucket via
# X-Forwarded-For.
TRUST_PROXY=0
# Origin allowed to call the API via CORS. Defaults to "*" if unset; set to
# the mobile app's actual origin in any environment where that matters.
MOBILE_APP_ORIGIN=*
# Email is optional — all three of the following are unset by default. When
# GMAIL_USER/GMAIL_APP_PASSWORD are unset, notification emails are disabled
# (in-app notifications are unaffected).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Base URL used to turn a notification's relative link into a clickable one
# in emails. Unset means the email omits the link button.
AUTH_URL=
