exports[`database schema has exactly these constraints 1`] = `
[
  ""Announcement" Announcement_audience_season_check: CHECK (((audience = 'SEASON'::"AnnouncementAudience") = ("seasonId" IS NOT NULL)))",
  ""Announcement" Announcement_authorId_fkey: FOREIGN KEY ("authorId") REFERENCES "User"(id) ON UPDATE CASCADE ON DELETE SET NULL",
  ""Announcement" Announcement_pkey: PRIMARY KEY (id)",
  ""Announcement" Announcement_seasonId_fkey: FOREIGN KEY ("seasonId") REFERENCES "Season"(id) ON UPDATE CASCADE ON DELETE CASCADE",
  ""AnnouncementPoll" AnnouncementPoll_announcementId_fkey: FOREIGN KEY ("announcementId") REFERENCES "Announcement"(id) ON UPDATE CASCADE ON DELETE CASCADE",
  ""AnnouncementPoll" AnnouncementPoll_closedById_fkey: FOREIGN KEY ("closedById") REFERENCES "User"(id) ON UPDATE CASCADE ON DELETE SET NULL",
  ""AnnouncementPoll" AnnouncementPoll_pkey: PRIMARY KEY (id)",
  ""AnnouncementPollOption" AnnouncementPollOption_pkey: PRIMARY KEY (id)",
  ""AnnouncementPollOption" AnnouncementPollOption_pollId_fkey: FOREIGN KEY ("pollId") REFERENCES "AnnouncementPoll"(id) ON UPDATE CASCADE ON DELETE CASCADE",
  ""AnnouncementPollVote" AnnouncementPollVote_optionId_pollId_fkey: FOREIGN KEY ("optionId", "pollId") REFERENCES "AnnouncementPollOption"(id, "pollId") ON UPDATE CASCADE ON DELETE CASCADE",
  ""AnnouncementPollVote" AnnouncementPollVote_pkey: PRIMARY KEY ("optionId", "userId")",
  ""AnnouncementPollVote" AnnouncementPollVote_pollId_fkey: FOREIGN KEY ("pollId") REFERENCES "AnnouncementPoll"(id) ON UPDATE CASCADE ON DELETE CASCADE",
  ""AnnouncementPollVote" AnnouncementPollVote_userId_fkey: FOREIGN KEY ("userId") REFERENCES "User"(id) ON UPDATE CASCADE ON DELETE CASCADE",
  ""AnnouncementRead" AnnouncementRead_announcementId_fkey: FOREIGN KEY ("announcementId") REFERENCES "Announcement"(id) ON UPDATE CASCADE ON DELETE CASCADE",
  ""AnnouncementRead" AnnouncementRead_pkey: PRIMARY KEY ("announcementId", "userId")",
  ""AnnouncementRead" AnnouncementRead_userId_fkey: FOREIGN KEY ("userId") REFERENCES "User"(id) ON UPDATE CASCADE ON DELETE CASCADE",
  ""Assignment" Assignment_createdById_fkey: FOREIGN KEY ("createdById") REFERENCES "User"(id) ON UPDATE CASCADE ON DELETE SET NULL",
  ""Assignment" Assignment_pkey: PRIMARY KEY (id)",
  ""Assignment" Assignment_reminderDays_check: CHECK ((("reminderDays" >= 1) AND ("reminderDays" <= 14)))",
  ""Assignment" Assignment_reminderTime_check: CHECK (("reminderTime" ~ '^[0-2][0-9]:[0-5][0-9]$'::text))",
  ""Assignment" Assignment_seasonId_fkey: FOREIGN KEY ("seasonId") REFERENCES "Season"(id) ON UPDATE CASCADE ON DELETE CASCADE",
  ""Assignment" Assignment_updatedById_fkey: FOREIGN KEY ("updatedById") REFERENCES "User"(id) ON UPDATE CASCADE ON DELETE SET NULL",
  ""AssignmentPart" AssignmentPart_allowedMimeCategories_check: CHECK (("allowedMimeCategories" <@ ARRAY['image'::text, 'pdf'::text, 'doc'::text, 'audio'::text, 'video'::text, 'text'::text]))",
  ""AssignmentPart" AssignmentPart_assignmentId_fkey: FOREIGN KEY ("assignmentId") REFERENCES "Assignment"(id) ON UPDATE CASCADE ON DELETE CASCADE",
  ""AssignmentPart" AssignmentPart_pkey: PRIMARY KEY (id)",
