{
  "name": "@space/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-swagger-assets.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/apps/backend/src/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --testPathIgnorePatterns \"/integration/\"",
    "test:integration": "jest --config jest.integration.config.js --testPathPattern integration",
    "clean": "rm -rf dist src/generated",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate:local": "bash scripts/apply-migrations.sh",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "seed:sweep": "ts-node --transpile-only scripts/seed-sweep.ts",
    "create:super-admin": "ts-node --transpile-only scripts/create-super-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.10.0",
    "@space/shared": "workspace:*",
    "@vercel/functions": "^3.10.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@space/config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
