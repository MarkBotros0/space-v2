// JPC Space — Prisma schema. Diagrams: docs/database/erd.md (pnpm --filter @space/backend db:erd).
// Changes ship as migrations (prisma/migrations, applied with `migrate deploy`), each with a
// hand-written rollback.sql beside it. Never run `prisma migrate dev` against a migrated database:
// it would drop the SQL-only objects listed in the models below.
// Conventions, as the tables actually are:
//   - Integer PKs (serial4) via `Int @id @default(autoincrement())`, not BigInt (owner, refactor Q1).
//     Link tables use a composite PK instead; RateLimitHit is keyed by `key` (text).
//   - Columns are camelCase, tables PascalCase (refactor Q2).
//   - Timestamps are timestamptz(3), written in UTC; a calendar day is `date` (User.dateOfBirth).
//   - `createdAt` / `updatedAt` on entities whose rows are updated. Append-only rows (tokens,
//     notifications, responses, files) have no `updatedAt`; pure links have neither.
//   - Soft delete (`deletedAt`) on User, Season and Assignment. Everything else is hard-deleted.
//   - Audit columns: createdById on Season, Assignment, Quiz, JpcEvent, SessionVideoQuestion;
//     updatedById on Season and Assignment.
//   - `publicId` (nanoid, 10 chars) only on Submission and AssignmentPartWork, per the per-entity
//     URL strategy.
//   - Rules Prisma cannot express (CHECKs, partial indexes) are listed at the end of their model
//     as `// SQL-only <kind> <name>: <definition>`; schema-snapshot.test.ts fails on one missing.
//   - src/__tests__/schema-conformance.test.ts holds the base columns, an index on every foreign key
//     (the audit trail to User excepted) and link tables keyed by their pair; its lists name the exceptions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER
  ADMIN
  LEADER
  STUDENT
  MENTOR
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum EnrollmentResult {
  PASSED
  NOT_PASSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  RETURNED
}

enum NoteVisibility {
  LEADERS
  MENTORS
  ADMINS
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum NotificationType {
  ASSIGNMENT_CREATED
  SUBMISSION_REVIEWED
  SESSION_RESCHEDULED
  LOW_ATTENDANCE_FLAG
  MENTOR_FOLLOWUP
  QUIZ_GRADED
  QUIZ_PUBLISHED
  SUBMISSION_RECEIVED
  SESSION_CANCELLED
  ANNOUNCEMENT
  ASSIGNMENT_REMINDER
}

enum AnnouncementAudience {
  COMMUNITY
  SEASON
}

enum JpcVisibility {
  ALL
  ALUMNI_ONLY
  SEASON
}

enum AssignmentPartKind {
  VIDEO
  ESSAY
  FORUM
}

// What an assignment's reminder counts back from.
enum ReminderAnchor {
  NEXT_SESSION
  DUE_DATE
}

enum QuizKind {
  PAPER
  ONLINE
}

enum QuizQuestionType {
  MCQ // legacy, no rows after 20261112040000
  ESSAY
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  MATCHING
  FILL_BLANK
}

enum QuizOptionSide {
  LEFT
  RIGHT
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

// Why an attempt stopped being IN_PROGRESS (null on attempts that predate it).
enum QuizAttemptEndReason {
  SUBMITTED
  TIMED_OUT
  ENDED_BY_STAFF
  ENDED_BY_EXITS
}

// What the phone saw while an attempt was open. EXIT and RELAUNCH count towards the
// exit limit; SCREENSHOT is logged only.
enum QuizAttemptEventKind {
  EXIT
  RELAUNCH
  SCREENSHOT
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

model User {
  announcementsAuthored Announcement[]     @relation("AnnouncementAuthor")
  announcementReads     AnnouncementRead[]
  announcementPollsClosed AnnouncementPoll[] @relation("AnnouncementPollClosedBy")
  announcementPollVotes AnnouncementPollVote[]
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String?
  role         UserRole
  // Set when a student graduates from JPCS. Doubles as the "is an alumnus" marker
  // and gates eligibility for LEADER/SEASON_ADMIN/MENTOR roles (only alumni may hold them).
  graduationYear Int?
  // Set only when a super graduated someone who hadn't passed a graduating season
  // (the rare exception). Shown to SUPER alone; the reason is never logged.
  graduationOverrideAt     DateTime? @db.Timestamptz(3)
  graduationOverrideById   Int?
  graduationOverrideBy     User?     @relation("GraduationOverrideBy", fields: [graduationOverrideById], references: [id], onDelete: SetNull)
  graduationOverrideReason String?
  // Account-level contact fields, for every role (owner 2026-11-06). Replace
  // StudentProfile.phone/dateOfBirth, which stay in the table but are unused.
  phone        String?
  // A calendar day (a date column; Prisma reads it as UTC midnight).
  dateOfBirth  DateTime? @db.Date
  address      String?
  avatarPath   String?
  lastLoginAt  DateTime? @db.Timestamptz(3)
  // Access tokens issued before this instant are refused by requireAuth (Plan
  // 18 M13). Written by logout-all, password change and reset, deactivation
  // and role change. Null: nothing has been invalidated.
  sessionsValidFrom DateTime? @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  studentProfile StudentProfile?

  seasonAdminAssignments     SeasonAdmin[] @relation("SeasonAdminUser")
  seasonAdminAssignmentsMade SeasonAdmin[] @relation("SeasonAdminAssignedBy")
  groupLeaderAssignments     GroupLeader[]
  groupStudentMemberships    GroupStudent[]

  invitesReceived     InviteToken[]        @relation("InviteUser")
  invitesIssued       InviteToken[]        @relation("InviteIssuedBy")
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  seasonsCreated          Season[]         @relation("SeasonCreatedBy")
  seasonsUpdated          Season[]         @relation("SeasonUpdatedBy")
  assignmentsCreated      Assignment[]     @relation("AssignmentCreatedBy")
  assignmentsUpdated      Assignment[]     @relation("AssignmentUpdatedBy")
  partWorkReviewed        AssignmentPartWork[] @relation("PartWorkReviewedBy")
  attendanceMarked        Attendance[]     @relation("AttendanceMarkedBy")
  engagementNotesAuthored EngagementNote[] @relation("EngagementNoteAuthor")

  attendanceRecords    Attendance[]       @relation("AttendanceStudent")
  submissionsAsStudent Submission[]       @relation("SubmissionStudent")
  partWorkAsStudent    AssignmentPartWork[] @relation("PartWorkStudent")
  seasonEnrollments    SeasonEnrollment[] @relation("EnrollmentStudent")
  enrollmentOverrides  SeasonEnrollment[] @relation("EnrollmentOverrideBy")
  graduationOverrides  User[]             @relation("GraduationOverrideBy")
  engagementNotesAbout EngagementNote[]   @relation("EngagementNoteStudent")
  followUpsByMe        MentorFollowUp[]   @relation("FollowUpMentor")
  followUpsAboutMe     MentorFollowUp[]   @relation("FollowUpStudent")

  notifications            Notification[]
  notificationPreference   NotificationPreference?
  deviceTokens             DeviceToken[]
  jpcEventsCreated         JpcEvent[]              @relation("JpcEventCreator")

  quizzesCreated Quiz[]      @relation("QuizCreatedBy")
  quizzesReleased Quiz[]     @relation("QuizResultsReleasedBy")
  quizGrades     QuizGrade[] @relation("QuizGradeStudent")
  quizGraded     QuizGrade[] @relation("QuizGradedBy")

  quizAttempts       QuizAttempt[] @relation("QuizAttemptStudent")
  quizAttemptsGraded QuizAttempt[] @relation("QuizAttemptGradedBy")
  quizAttemptsEnded  QuizAttempt[] @relation("QuizAttemptEndedBy")

  forumCommentsAuthored ForumComment[] @relation("ForumCommentAuthor")

  videoQuestionsCreated SessionVideoQuestion[]         @relation("VideoQuestionCreatedBy")
  videoResponses        SessionVideoQuestionResponse[] @relation("VideoResponseStudent")
  videoProgress         SessionVideoProgress[]         @relation("VideoProgressStudent")

  @@index([role])
  @@index([deletedAt])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only CHECK User_email_lowercase_check: email = lower(email) (so the unique is case-insensitive in effect; write it trimmed and lowercased)
}

model InviteToken {
  id          Int       @id @default(autoincrement())
  tokenHash       String    @unique @map("token") // a SHA-256 hex digest, never the raw token
  userId      Int
  user        User      @relation("InviteUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedById Int
  invitedBy   User      @relation("InviteIssuedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt   DateTime @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

// Refresh tokens for the mobile/API token-auth flow. The web app keeps using
// Auth.js session cookies; native clients exchange these for short-lived access
// tokens. Stored hashed so they can be revoked.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash     String    @unique @map("token") // a SHA-256 hex digest, never the raw token
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Student profile
// ---------------------------------------------------------------------------

model StudentProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  university          String?
  faculty             String?
  // The student's university graduation year (may be in the future). Not
  // User.graduationYear, which is the JPCS-alumni marker.
  universityGraduationYear Int?
  notes               String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Seasons (courses)
// ---------------------------------------------------------------------------

model Season {
  announcements Announcement[]
  id             Int          @id @default(autoincrement())
  code           String       @unique // e.g. "gbv-2026" — URL identifier
  title          String // e.g. "GBV 2026" — display title
  program        String // e.g. "GBV" — the recurring program; groups a season's year history
  requiredProgram String? // a program a student must have passed to join; SUPER-only, draft-only
  graduatesOnPass Boolean @default(false) // passing makes an alumnus; SUPER-only, frozen once finished
  isCommunityWide Boolean @default(false) // anyone may study, alumni too; no required program, graduates nobody; SUPER-only, draft-only
  year           Int // e.g. 2026 — the cohort year within the program
  description    String?
  startDate      DateTime @db.Timestamptz(3)
  endDate        DateTime @db.Timestamptz(3)
  status         SeasonStatus @default(DRAFT)

  absenceBudgetMinutes Int @default(180)
  absenceWeightMinutes Int @default(90)

  createdById Int?
  createdBy   User?     @relation("SeasonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   User?     @relation("SeasonUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  admins            SeasonAdmin[]
  groups            Group[]
  sessions          Session[]
  assignments       Assignment[]
  enrollments       SeasonEnrollment[]
  jpcEvents         JpcEvent[]         @relation("JpcEventSeason")
  engagementNotes   EngagementNote[]
  quizzes           Quiz[]

  @@index([status])
  @@index([startDate])
  @@index([program, year])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only CHECK Season_endDate_check: endDate >= startDate
  // SQL-only CHECK Season_absenceMinutes_check: absenceBudgetMinutes >= 0 AND absenceWeightMinutes > 0
}

model SeasonAdmin {
  seasonId     Int
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation("SeasonAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)
  assignedById Int?
  assignedBy   User?    @relation("SeasonAdminAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([seasonId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------

model Group {
  id          Int      @id @default(autoincrement())
  seasonId    Int
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  leaders           GroupLeader[]
  students          GroupStudent[]
  seasonEnrollments SeasonEnrollment[]

  // Target of GroupStudent's composite foreign key (Plan 18 M1).
  @@unique([id, seasonId])
  // Exact match, as validateGroupWrite compares (migration 20261110090000).
  @@unique([seasonId, name])
  @@index([seasonId])
}

model GroupLeader {
  groupId    Int
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([groupId, userId])
  @@index([userId])
}

// Group membership, one row per student per season (Plan 18 M1). Mirrors
// SeasonEnrollment.groupId, which stays the authority (ruling C9).
// `seasonId` is denormalised from Group.seasonId to carry the per-season
// unique; the composite foreign key to Group(id, seasonId) means it can never
// disagree with its group's season.
model GroupStudent {
  groupId       Int
  seasonId      Int
  group         Group    @relation(fields: [groupId, seasonId], references: [id, seasonId], onDelete: Cascade)
  studentUserId Int
  studentUser   User     @relation(fields: [studentUserId], references: [id], onDelete: Restrict)
  enrolledAt    DateTime @default(now()) @db.Timestamptz(3)

  @@id([groupId, studentUserId])
  @@unique([seasonId, studentUserId])
  @@index([studentUserId])
}

// Append-only history: which students were in which seasons (and groups).
model SeasonEnrollment {
  id            Int              @id @default(autoincrement())
  studentUserId Int
  studentUser   User             @relation("EnrollmentStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  seasonId      Int
  season        Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  groupId       Int?
  group         Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status        EnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime         @default(now()) @db.Timestamptz(3)
  completedAt   DateTime? @db.Timestamptz(3)
  droppedAt     DateTime? @db.Timestamptz(3) // set when status transitions to WITHDRAWN
  dropReason    String?
  // Set when the season ends (or a SUPER/ADMIN corrects it later); null until then.
  result        EnrollmentResult?
  resultReason  String?
  resultSetAt   DateTime? @db.Timestamptz(3)
  // A SUPER let this person in past a block; null when nobody did.
  overrideById  Int?
  overrideBy    User?            @relation("EnrollmentOverrideBy", fields: [overrideById], references: [id], onDelete: SetNull)
  overrideAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([studentUserId, seasonId])
  @@index([seasonId, status])
  @@index([groupId, status])
}

// ---------------------------------------------------------------------------
// Sessions (calendar)
// ---------------------------------------------------------------------------

model Session {
  id                Int       @id @default(autoincrement())
  seasonId          Int
  season            Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  title             String
  startsAt          DateTime @db.Timestamptz(3)
  durationMinutes   Int       @default(90)
  location          String?
  youtubeUrl        String?
  description       String?
  // Sibling sessions created in the same recurrence batch share this id.
  recurrenceGroupId String?
  checkInToken      String?   @unique
  checkInOpenAt     DateTime? @db.Timestamptz(3)
  checkInClosedAt   DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  attendance     Attendance[]
  quizzes        Quiz[]
  videoQuestions SessionVideoQuestion[]
  videoProgress  SessionVideoProgress[]

  @@index([seasonId, startsAt])
  @@index([startsAt])
  @@index([recurrenceGroupId])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only CHECK Session_durationMinutes_check: durationMinutes > 0
}

// Interactive video quizzes: admin places timed MCQ questions on a session's
// video or on an assignment's Video part (exactly one of the two); students
// answer inline while watching (graded, gated, no retries).
model SessionVideoQuestion {
  id               Int             @id @default(autoincrement())
  sessionId        Int?
  session          Session?        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignmentPartId Int?
  assignmentPart   AssignmentPart? @relation(fields: [assignmentPartId], references: [id], onDelete: Cascade)
  atSeconds    Int
  prompt       String
  options      String[]
  correctIndex Int
  points       Int      @default(1)
  createdById  Int?
  createdBy    User?    @relation("VideoQuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  responses SessionVideoQuestionResponse[]

  @@index([sessionId, atSeconds])
  @@index([assignmentPartId, atSeconds])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only CHECK SessionVideoQuestion_points_check: points >= 0
  // SQL-only CHECK SessionVideoQuestion_correctIndex_check: 0 <= correctIndex < cardinality(options)
  // SQL-only CHECK SessionVideoQuestion_owner_check: num_nonnulls(sessionId, assignmentPartId) = 1
}

model SessionVideoQuestionResponse {
  id            Int                  @id @default(autoincrement())
  questionId    Int
  question      SessionVideoQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentUserId Int
  studentUser   User                 @relation("VideoResponseStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  selectedIndex Int
  isCorrect     Boolean
  answeredAt    DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([questionId, studentUserId])
  @@index([studentUserId])
}

model SessionVideoProgress {
  id              Int       @id @default(autoincrement())
  sessionId       Int
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentUserId   Int
  studentUser     User      @relation("VideoProgressStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  furthestSeconds Int       @default(0)
  completedAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([sessionId, studentUserId])
}

model Attendance {
  id            Int              @id @default(autoincrement())
  sessionId     Int
  session       Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentUserId Int
  studentUser   User             @relation("AttendanceStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  status        AttendanceStatus
  notes         String?
  markedById    Int?
  markedBy      User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt      DateTime         @default(now()) @db.Timestamptz(3)
  checkedInAt   DateTime? @db.Timestamptz(3)
  lateMinutes   Int?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([sessionId, studentUserId])
  @@index([studentUserId])
}

// ---------------------------------------------------------------------------
// Assignments & submissions
// ---------------------------------------------------------------------------

// An assignment reaches its whole season; its work is the ordered list of parts.
model Assignment {
  id          Int       @id @default(autoincrement())
  seasonId    Int
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime? @db.Timestamptz(3)

  // Reminder: `reminderDays` before the anchor at `reminderTime` (HH:MM). `remindAt` is resolved
  // on save; the scheduler's sweep sets `remindedAt` when it sends.
  reminderEnabled Boolean        @default(true)
  reminderDays    Int            @default(2)
  reminderAnchor  ReminderAnchor @default(NEXT_SESSION)
  reminderTime    String         @default("09:00")
  remindAt        DateTime?      @db.Timestamptz(3)
  remindedAt      DateTime?      @db.Timestamptz(3)

  createdById Int?
  createdBy   User?     @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   User?     @relation("AssignmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  parts       AssignmentPart[]
  submissions Submission[]

  @@index([seasonId])
  @@index([dueAt])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only CHECK Assignment_reminderDays_check: reminderDays BETWEEN 1 AND 14
  // SQL-only CHECK Assignment_reminderTime_check: reminderTime ~ '^[0-2][0-9]:[0-5][0-9]$'
  // SQL-only INDEX Assignment_remind_due_idx: (remindAt) WHERE remindedAt IS NULL AND deletedAt IS NULL
}

// One part of an assignment: a Video, an Essay or a Forum, with that kind's settings.
model AssignmentPart {
  id           Int                @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  position     Int
  kind         AssignmentPartKind
  title        String?

  // VIDEO
  youtubeId       String?
  youtubeUrl      String?
  durationSeconds Int?
  blockSkipping   Boolean @default(false)

  // ESSAY and FORUM (minWords); ESSAY only (maxWords, files). No file limit means no uploads.
  prompt                String?
  minWords              Int?
  maxWords              Int?
  maxFileSizeMb         Int?
  allowedMimeCategories String[] @default([])

  // FORUM: group-mates' posts show only after the student's own; peers may comment.
  postToRead    Boolean @default(true)
  allowComments Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  work           AssignmentPartWork[]
  videoQuestions SessionVideoQuestion[]

  @@index([assignmentId, position])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only CHECK AssignmentPart_video_check: kind <> VIDEO OR youtubeId IS NOT NULL
  // SQL-only CHECK AssignmentPart_prompt_check: kind NOT IN (ESSAY, FORUM) OR prompt IS NOT NULL
  // SQL-only CHECK AssignmentPart_words_check: minWords <= maxWords
  // SQL-only CHECK AssignmentPart_allowedMimeCategories_check: allowedMimeCategories <@ {image, pdf, doc, audio, video, text}
  // SQL-only UNIQUE INDEX AssignmentPart_one_forum: (assignmentId) WHERE kind = FORUM
}

// A student's one row per assignment; the work itself is per part (AssignmentPartWork).
model Submission {
  id            Int        @id @default(autoincrement())
  // URL identifier, per the per-entity strategy.
  publicId      String     @unique
  assignmentId  Int
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentUserId Int
  studentUser   User       @relation("SubmissionStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  submittedAt   DateTime?  @db.Timestamptz(3)
  // Every part done.
  completedAt   DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  partWork AssignmentPartWork[]

  @@unique([assignmentId, studentUserId])
  @@index([studentUserId])
}

// One student's work on one part: a video's progress, an essay and its review, or a forum post.
model AssignmentPartWork {
  id            Int              @id @default(autoincrement())
  // URL identifier, per the per-entity strategy.
  publicId      String           @unique
  partId        Int
  part          AssignmentPart   @relation(fields: [partId], references: [id], onDelete: Cascade)
  submissionId  Int
  submission    Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  studentUserId Int
  studentUser   User             @relation("PartWorkStudent", fields: [studentUserId], references: [id], onDelete: Restrict)

  // ESSAY and FORUM
  text         String?
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?        @db.Timestamptz(3)
  reviewedAt   DateTime?        @db.Timestamptz(3)
  feedback     String?
  reviewedById Int?
  reviewedBy   User?            @relation("PartWorkReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  // VIDEO: merged [start, end] second intervals watched.
  watchedIntervals Json      @default("[]")
  watchedSeconds   Int       @default(0)
  furthestSeconds  Int       @default(0)
  lastReportAt     DateTime? @db.Timestamptz(3)

  doneAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  files         SubmissionFile[]
  forumComments ForumComment[]

  @@unique([partId, studentUserId])
  @@index([submissionId])
  @@index([studentUserId])
  @@index([partId, status])
  @@index([reviewedById])
  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only INDEX AssignmentPartWork_queue_idx: (status, submittedAt DESC NULLS LAST, id DESC) WHERE status <> 'DRAFT' (the review queue and the mentor's handed-in feed)
  // SQL-only INDEX AssignmentPartWork_reviewed_idx: (reviewedAt DESC, id DESC) WHERE reviewedAt IS NOT NULL (the mentor's reviewed feed)
}

// A file attached to an essay part's work.
model SubmissionFile {
  id           Int                @id @default(autoincrement())
  partWorkId   Int
  partWork     AssignmentPartWork @relation(fields: [partWorkId], references: [id], onDelete: Cascade)
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime           @default(now()) @db.Timestamptz(3)

  @@index([partWorkId])
}

// Peer comments on a forum part's post (the parent AssignmentPartWork).
// Only created when the part has `allowComments = true`.
model ForumComment {
  id           Int                @id @default(autoincrement())
  partWorkId   Int
  partWork     AssignmentPartWork @relation(fields: [partWorkId], references: [id], onDelete: Cascade)
  authorUserId Int
  authorUser   User               @relation("ForumCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  body         String
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  @@index([partWorkId])
  @@index([authorUserId])
}

// ---------------------------------------------------------------------------
// Engagement notes
// ---------------------------------------------------------------------------

model EngagementNote {
  id              Int            @id @default(autoincrement())
  studentUserId   Int
  studentUser     User           @relation("EngagementNoteStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  authorUserId    Int
  authorUser      User           @relation("EngagementNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  seasonId        Int?
  season          Season?        @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  body            String
  visibility      NoteVisibility @default(LEADERS)
  followUpFlagged Boolean        @default(false)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@index([studentUserId, createdAt])
  @@index([authorUserId])
}

// A mentor's promise to come back to a student (owner, 2026-11-07). Due 7 days
// after it is made; the daily reminder sends one MENTOR_FOLLOWUP to that mentor
// and stamps remindedAt; it stays open until doneAt. At most one open per
// mentor and student (a partial unique index in the migration).
model MentorFollowUp {
  id            Int       @id @default(autoincrement())
  mentorUserId  Int
  mentorUser    User      @relation("FollowUpMentor", fields: [mentorUserId], references: [id], onDelete: Cascade)
  studentUserId Int
  studentUser   User      @relation("FollowUpStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  reason        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3) // default: rows from before the column, and older builds' inserts
  dueAt         DateTime @db.Timestamptz(3)
  remindedAt    DateTime? @db.Timestamptz(3)
  doneAt        DateTime? @db.Timestamptz(3)

  @@index([mentorUserId, doneAt])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only UNIQUE INDEX MentorFollowUp_one_open: (mentorUserId, studentUserId) WHERE doneAt IS NULL
  // SQL-only INDEX MentorFollowUp_due_open_idx: (dueAt) WHERE doneAt IS NULL AND remindedAt IS NULL
}

// ---------------------------------------------------------------------------
// Notifications & documents
// ---------------------------------------------------------------------------

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignmentCreated  Boolean @default(true)
  submissionReviewed Boolean @default(true)
  sessionRescheduled Boolean @default(true)
  lowAttendanceFlag  Boolean @default(true)
  mentorFollowup     Boolean @default(true)
  quizGraded         Boolean @default(true)
  quizPublished      Boolean @default(true)
  submissionReceived Boolean @default(true)
  sessionCancelled   Boolean @default(true)
  announcement       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Quizzes (paper-based, graded by leader/admin)
// ---------------------------------------------------------------------------

model Quiz {
  id          Int       @id @default(autoincrement())
  seasonId    Int
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  sessionId   Int?
  session     Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  title       String
  kind        QuizKind  @default(PAPER)
  // For ONLINE quizzes maxScore is recomputed as the sum of question points.
  maxScore    Int       @default(100)
  // ONLINE: each attempt sees the questions in its own order (QuizAttempt.shuffleSeed).
  shuffleQuestions Boolean @default(true)
  // ONLINE availability: null = draft, students only see published quizzes.
  publishedAt DateTime? @db.Timestamptz(3)
  createdById Int?
  createdBy   User?     @relation("QuizCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Students see their scores, and which answers were right, only once the
  // season's admin (or a super) releases the results (owner, 2026-11-07): a
  // student who takes it later can't learn the answers from one who took it first.
  resultsReleasedAt   DateTime? @db.Timestamptz(3) // "answers released" since the quiz-types plan
  resultsReleasedById Int?
  resultsReleasedBy   User?     @relation("QuizResultsReleasedBy", fields: [resultsReleasedById], references: [id], onDelete: SetNull)
  // ONLINE timing. The window limits STARTING only; the limit is per student, from the moment they open the attempt.
  startsFrom       DateTime? @db.Timestamptz(3)
  startsUntil      DateTime? @db.Timestamptz(3)
  timeLimitMinutes Int?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  grades    QuizGrade[]
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([seasonId])
  @@index([sessionId])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only CHECK Quiz_timeLimitMinutes_check: timeLimitMinutes IS NULL OR timeLimitMinutes BETWEEN 1 AND 300
  // SQL-only CHECK Quiz_start_window_check: startsFrom IS NULL OR startsUntil IS NULL OR startsFrom < startsUntil
}

model QuizGrade {
  id            Int       @id @default(autoincrement())
  quizId        Int
  quiz          Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentUserId Int
  studentUser   User      @relation("QuizGradeStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  score         Int?
  notes         String?
  gradedById    Int?
  gradedBy      User?     @relation("QuizGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt      DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([quizId, studentUserId])
  @@index([studentUserId])
}

// Questions for an ONLINE quiz. Choice, true/false and matching questions carry
// QuizOption rows and fill-in-the-blank ones QuizBlank rows (auto-graded); ESSAY
// questions are graded manually by a leader/admin.
model QuizQuestion {
  id           Int              @id @default(autoincrement())
  quizId       Int
  quiz         Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order        Int
  type         QuizQuestionType
  prompt       String
  points       Int              @default(1)
  // legacy: read by nothing after the quiz-types plan; dropped by a later contract migration
  options      String[]
  // legacy: read by nothing after the quiz-types plan; dropped by a later contract migration
  correctIndex Int?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  answers     QuizAnswer[]
  quizOptions QuizOption[]
  quizBlanks  QuizBlank[]

  @@index([quizId, order])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only CHECK QuizQuestion_points_check: points >= 0
}

// A student's run at an ONLINE quiz. One active attempt per student; an admin
// can reopen a retake, which creates a new attempt with the next attemptNumber.
model QuizAttempt {
  id            Int               @id @default(autoincrement())
  quizId        Int
  quiz          Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentUserId Int
  studentUser   User              @relation("QuizAttemptStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  attemptNumber Int               @default(1)
  status        QuizAttemptStatus @default(IN_PROGRESS)
  autoScore     Decimal?          @db.Decimal(8, 2)
  manualScore   Decimal?          @db.Decimal(8, 2)
  totalScore    Decimal?          @db.Decimal(8, 2)
  // Seeds this attempt's question and option order: a random 31-bit value set when
  // the attempt starts or is reopened (0 only on rows that predate it).
  shuffleSeed   Int               @default(0)
  submittedAt   DateTime? @db.Timestamptz(3)
  gradedById    Int?
  gradedBy      User?             @relation("QuizAttemptGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt      DateTime? @db.Timestamptz(3)
  // Server-clock end of the time limit, set when the student first opens the attempt (null = untimed).
  deadlineAt    DateTime?            @db.Timestamptz(3)
  endReason     QuizAttemptEndReason?
  // Set only when staff end the attempt.
  endedById     Int?
  endedBy       User?                @relation("QuizAttemptEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  answers QuizAnswer[]
  events  QuizAttemptEvent[]

  @@unique([quizId, studentUserId, attemptNumber])
  @@index([studentUserId])
  @@index([quizId, status])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only UNIQUE INDEX QuizAttempt_one_in_progress_key: (quizId, studentUserId) WHERE status = 'IN_PROGRESS'
  // SQL-only INDEX QuizAttempt_deadline_open_idx: (deadlineAt) WHERE status = 'IN_PROGRESS' AND deadlineAt IS NOT NULL
  // SQL-only CHECK QuizAttempt_totalScore_check: totalScore IS NULL OR totalScore = coalesce(autoScore, 0) + coalesce(manualScore, 0)
}

// One exit, relaunch or blocked screenshot the phone reported for an open attempt.
// Keyed by the phone's own id, so a retry or an offline replay is stored once.
// Written once with both times (the phone reports on return) and never updated.
model QuizAttemptEvent {
  id            Int                  @id @default(autoincrement())
  attemptId     Int
  attempt       QuizAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  kind          QuizAttemptEventKind
  // A UUID the phone made when it saw the event.
  clientEventId String
  leftAt        DateTime             @db.Timestamptz(3)
  returnedAt    DateTime?            @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([attemptId, clientEventId])
  @@index([attemptId, leftAt])
}

model QuizAnswer {
  id            Int          @id @default(autoincrement())
  attemptId     Int
  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    Int
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // legacy: read by nothing after the quiz-types plan; dropped by a later contract migration
  selectedIndex Int?
  text          String?
  isCorrect     Boolean?
  pointsAwarded Decimal?     @db.Decimal(8, 2)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  selections QuizAnswerSelection[]
  blanks     QuizAnswerBlank[]

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// An option of a choice, true/false or matching question. A matching question has
// LEFT and RIGHT rows; a LEFT row's matchId is its correct RIGHT row.
model QuizOption {
  id         Int             @id @default(autoincrement())
  questionId Int
  question   QuizQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  label      String
  isCorrect  Boolean         @default(false)
  side       QuizOptionSide?
  matchId    Int?
  match      QuizOption?     @relation("QuizOptionMatch", fields: [matchId], references: [id], onDelete: SetNull)
  matchedBy  QuizOption[]    @relation("QuizOptionMatch")
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)

  selections        QuizAnswerSelection[] @relation("QuizAnswerSelected")
  matchedSelections QuizAnswerSelection[] @relation("QuizAnswerMatched")

  @@index([questionId, position])
  @@index([matchId])
}

// A gap in a fill-in-the-blank question and the text expected in it.
model QuizBlank {
  id         Int          @id @default(autoincrement())
  questionId Int
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  expected   String
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  answers QuizAnswerBlank[]

  @@unique([questionId, position])
}

// An option a student picked; for matching, a LEFT option and the RIGHT one paired with it.
model QuizAnswerSelection {
  answerId        Int
  answer          QuizAnswer  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  optionId        Int
  option          QuizOption  @relation("QuizAnswerSelected", fields: [optionId], references: [id], onDelete: Cascade)
  matchedOptionId Int?
  matchedOption   QuizOption? @relation("QuizAnswerMatched", fields: [matchedOptionId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  @@id([answerId, optionId])
  @@index([optionId])
  @@index([matchedOptionId])
}

// What a student wrote into one blank, and whether it matched.
model QuizAnswerBlank {
  answerId  Int
  answer    QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  blankId   Int
  blank     QuizBlank  @relation(fields: [blankId], references: [id], onDelete: Cascade)
  text      String
  isCorrect Boolean?
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@id([answerId, blankId])
  @@index([blankId])
}

// ---------------------------------------------------------------------------
// JPC Events (public-facing calendar)
// ---------------------------------------------------------------------------

model JpcEvent {
  id          Int           @id @default(autoincrement())
  title       String
  date        DateTime @db.Timestamptz(3)
  endDate     DateTime? @db.Timestamptz(3)
  description String?
  url         String?
  visibility  JpcVisibility @default(ALL)
  seasonId    Int?
  createdById Int?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  createdBy User?   @relation("JpcEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  season    Season? @relation("JpcEventSeason", fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([date])
}

// Expo push tokens, one row per device (v2-only; 2026-11-04). `token` is
// unique, not (userId, token): a phone handed to another user moves with the
// sign-in rather than notifying both. The token is a credential — never log it.
model DeviceToken {
  id         Int            @id @default(autoincrement())
  userId     Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([lastSeenAt])
}

// express-rate-limit hit counters shared by every serverless instance
// (lib/rate-limit/postgres-store.ts; v2-only, 2026-11-05). One row per
// limiter-prefixed client key, e.g. "auth:203.0.113.7". A row whose window has
// passed is restarted in place by the next hit; rows idle for an hour past
// their window are swept by the store itself, so the table stays small.
model RateLimitHit {
  key     String   @id
  hits    Int
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

// Request-driven scheduler lease (lib/scheduler/lease.ts): one row per job name. An
// instance claims it with a conditional UPDATE, so only one runs the sweep at a time.
model SchedulerLease {
  name        String    @id
  lockedUntil DateTime  @db.Timestamptz(3)
  lastRunAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

model Announcement {
  id        Int                  @id @default(autoincrement())
  audience  AnnouncementAudience
  seasonId  Int? // required when SEASON, null when COMMUNITY (checked in the route; a CHECK constraint too)
  body      String // 1..5000 after trim, plain text
  authorId  Int? // SetNull: the post outlives a deleted author ("Former member")
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @db.Timestamptz(3)
  editedAt  DateTime? @db.Timestamptz(3) // set by PATCH only; drives "Edited"
  season    Season?              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  author    User?                @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reads     AnnouncementRead[]
  poll      AnnouncementPoll?

  @@index([audience, createdAt])
  @@index([seasonId, createdAt])

  // SQL-only (prisma/migrations; not expressible in this file):
  // SQL-only CHECK Announcement_audience_season_check: (audience = 'SEASON') = (seasonId IS NOT NULL)
}

model AnnouncementRead {
  announcementId Int
  userId         Int
  readAt         DateTime     @default(now()) @db.Timestamptz(3)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

model AnnouncementPoll {
  id             Int                      @id @default(autoincrement())
  announcementId Int                      @unique
  allowsMultiple Boolean
  version        Int                      @default(1) // bumped when options change; a vote carries it
  closedAt       DateTime? @db.Timestamptz(3)
  closedById     Int? // SetNull: the poll outlives the closer's account
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @default(now()) @updatedAt @db.Timestamptz(3) // default: rows from before the column, and older builds' inserts
  announcement   Announcement             @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  closedBy       User?                    @relation("AnnouncementPollClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  options        AnnouncementPollOption[]
  votes          AnnouncementPollVote[]
}

model AnnouncementPollOption {
  id       Int                    @id @default(autoincrement())
  pollId   Int
  label    String // 1..150 after trim, plain text
  position Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3) // default: rows from before the column, and older builds' inserts
  poll     AnnouncementPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    AnnouncementPollVote[]

  // Target of the vote's (optionId, pollId) FK: a vote's poll is its option's poll (DB-029).
  @@unique([id, pollId])
  @@index([pollId, position])
}

model AnnouncementPollVote {
  optionId  Int
  pollId    Int
  userId    Int
  createdAt DateTime               @default(now()) @db.Timestamptz(3)
  option    AnnouncementPollOption @relation(fields: [optionId, pollId], references: [id, pollId], onDelete: Cascade)
  poll      AnnouncementPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([pollId, userId])
}
