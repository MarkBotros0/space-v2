{
  "expo": {
    "name": "JPC Space",
    "slug": "space-v2",
    "version": "1.0.16",
    "icon": "./assets/icon.png",
    "scheme": "spacev2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "JPC Space uses the camera to scan the check-in code your leader shows.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.334467367676-09f9lagimdcrgl7i4qa4qr7uaffjj6jt"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6FB",
          "dark": {
            "image": "./assets/splash-blank.png",
            "backgroundColor": "#0B1230"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://jpc-space-be.vercel.app",
      "googleWebClientId": "334467367676-4blqjhdr17q2i2bqfspflh5o8ednffc5.apps.googleusercontent.com",
      "googleIosClientId": "334467367676-09f9lagimdcrgl7i4qa4qr7uaffjj6jt.apps.googleusercontent.com",
      "eas": {
        "projectId": "633d9f9f-6744-45c9-854e-fa12c1025e52"
      }
    },
    "owner": "kdaniel5",
    "ios": {
      "bundleIdentifier": "com.jpc.space",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "16",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.jpc.space",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#243559"
      },
      "versionCode": 16
    }
  }
}
