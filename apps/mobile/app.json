{
  "expo": {
    "name": "JPC Space",
    "slug": "space-v2",
    "version": "0.1.0",
    "scheme": "spacev2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "JPC Space uses the camera to scan the check-in code your leader shows.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000",
      "publicBaseUrl": "https://replace-with-auth-url-host.invalid"
    },
    "ios": {
      "associatedDomains": [
        "applinks:replace-with-auth-url-host.invalid"
      ]
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "replace-with-auth-url-host.invalid",
              "pathPrefix": "/checkin/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    }
  }
}
