{
  "expo": {
    "name": "JPC Space",
    "slug": "space-v2",
    "version": "0.1.0",
    "scheme": "spacev2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000"
    },
    "ios": {
      "bundleIdentifier": "com.jpc.space",
      "supportsTablet": true
    },
    "android": {
      "package": "com.jpc.space"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
