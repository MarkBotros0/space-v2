{
  "expo": {
    "name": "JPC Space",
    "slug": "space-v2",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "scheme": "spacev2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "JPC Space uses the camera to scan the check-in code your leader shows.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://space-v2-be.vercel.app",
      "eas": {
        "projectId": "633d9f9f-6744-45c9-854e-fa12c1025e52"
      }
    },
    "owner": "kdaniel5",
    "ios": {
      "bundleIdentifier": "com.jpc.space",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jpc.space"
    }
  }
}
