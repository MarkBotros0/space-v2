EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Sentry crash and error reporting (src/lib/sentry.ts). Off while unset: the
# SDK is never initialised and nothing is sent. Set it in EAS for real builds
# (see "Turning on Sentry" in apps/backend/README.md).
# EXPO_PUBLIC_SENTRY_DSN=
# Environment tag on each event. Defaults to "development" in a dev bundle and
# "production" in a release build.
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time only (EAS), for source-map upload. Without SENTRY_AUTH_TOKEN the
# upload step is skipped and the build proceeds (app.config.js).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
